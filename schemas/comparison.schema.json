{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G25 comparison contract (runtime validator additionally checks frozen bytes, pairing, missingness and claim arithmetic)",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/bindings"
    },
    {
      "$ref": "#/$defs/attempt"
    },
    {
      "$ref": "#/$defs/window"
    },
    {
      "$ref": "#/$defs/paired_summary"
    }
  ],
  "$defs": {
    "omp": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "platform",
        "version",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "strata": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "runtime_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "api": {
          "const": "openai-completions"
        },
        "provider": {
          "const": "strata-local"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "model_id",
        "model_identity_sha256",
        "quantization",
        "runtime_identity_sha256",
        "api",
        "provider",
        "profile_id",
        "profile_fingerprint",
        "release_manifest_sha256"
      ],
      "additionalProperties": false
    },
    "ninfer": {
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "runtime_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "api": {
          "const": "openai-responses"
        },
        "provider": {
          "enum": [
            "ninfer-native-3090",
            "ninfer-native-4090",
            "ninfer-beta"
          ]
        },
        "lane": {
          "enum": [
            "rtx3090-native",
            "rtx4090-native",
            "rtx5090-docker-local"
          ]
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "model_id",
        "model_identity_sha256",
        "quantization",
        "runtime_identity_sha256",
        "api",
        "provider",
        "lane",
        "release_id",
        "manifest_sha256",
        "config_identity_sha256"
      ],
      "allOf": [
        {
          "if": {"properties": {"lane": {"const": "rtx5090-docker-local"}}},
          "then": {
            "required": ["image_digest"],
            "properties": {"provider": {"const": "ninfer-beta"}, "model_id": {"const": "q38-ninfer"}}
          },
          "else": {"not": {"required": ["image_digest"]}}
        }
      ],
      "additionalProperties": false
