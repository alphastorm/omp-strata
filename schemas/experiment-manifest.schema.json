{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-manifest.schema.json",
  "title": "Controller-reserved candidate-only comparison",
  "description": "Version 2 deliberately rejects incumbent-lifecycle manifests. Profiles, harness, retained primary evidence, full job manifest and private runner bytes are frozen. No controller reservation or restoration authority is conveyed by this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparison_only", "rationale", "host_role", "baseline", "candidate", "candidate_only_against", "job_manifest_sha256", "runner_sha256", "harness_files", "max_window_seconds", "return_budget_seconds"],
  "properties": {
    "schema_version": {"const": 2},
    "comparison_only": {"const": true},
    "rationale": {"type": "string", "minLength": 1},
    "host_role": {"enum": ["rtx5090-win-a", "rtxpro6000-win-a"]},
    "baseline": {"type": "object"},
    "candidate": {"type": "object"},
    "candidate_only_against": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "harness_files": {"type": "object"},
    "max_window_seconds": {"const": 12600},
    "return_budget_seconds": {"type": "integer", "minimum": 1800, "maximum": 10800},
    "job_subset": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "pattern": "^(WO2|G24|golden-1)/[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "job_subset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
