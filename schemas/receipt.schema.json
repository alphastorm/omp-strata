{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMP Strata qualification receipt (starting contract)",
  "description": "Structural draft; implement additional semantic checks for identity, gate applicability, actual evidence and capability/status consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "gate_id",
    "status",
    "execution_boundary",
    "timestamp_utc",
    "implementation_commit",
    "profile_id",
    "identity_fingerprint",
    "expected",
    "observed",
    "evidence",
    "metrics",
    "limitations",
    "retry_history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_id": {
      "enum": [
        "G00",
        "G01",
        "G02",
        "G03",
        "G04",
        "G05",
        "G06",
        "G10",
        "G11",
        "G12",
        "G13",
        "G14",
        "G15",
        "G16",
        "G17",
        "G18",
        "G19",
        "G20",
        "G21",
        "G22",
        "G23",
        "G24",
        "G25",
        "G26"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "not_run",
        "not_applicable"
      ]
    },
    "execution_boundary": {
      "enum": [
        "source",
        "host_free",
        "real_host",
        "evaluation"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "implementation_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "identity_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path_or_ref",
          "sha256",
          "scrubbed"
        ],
        "properties": {
          "kind": {
            "enum": [
              "test_report",
              "verifier_result",
              "public_fixture",
              "redacted_log",
              "config_audit",
              "network_audit",
              "resource_record",
              "source_reference",
              "install_record"
            ]
          },
          "path_or_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "scrubbed": {
            "type": "boolean"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "boundary",
          "method"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "monotonic_wall_clock",
              "server_reported",
              "external_verifier",
              "resource_sampler",
              "calculated",
              "unavailable"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "status",
          "reason"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "gate_title": {
      "type": "string",
      "minLength": 1
    },
    "gate_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "implementation_commit": {
            "type": "string"
          },
          "identity_fingerprint": {
            "type": "string"
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "not_applicable"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          },
          "execution_boundary": {
            "enum": [
              "real_host",
              "evaluation"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "profile_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
