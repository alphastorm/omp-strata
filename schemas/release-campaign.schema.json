{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-campaign.schema.json",
  "title": "Frozen upstream release and independent host qualification campaign",
  "description": "Discovery never qualifies a host. Runtime checks additionally enforce unique assets and host profiles, immutable release identity, pending-only supersession and evidence-backed qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "release_id", "tag", "peeled_commit", "tag_object_sha", "assets", "published_at", "discovered_at", "status", "hosts", "disposition_notes"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"const": "Niko1221/Strata"},
    "release_id": {"type": "integer", "minimum": 1},
    "tag": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tag_object_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "published_at": {"type": "string", "format": "date-time"},
    "discovered_at": {"type": "string", "format": "date-time"},
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "digest", "size"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    },
    "status": {"enum": ["pending", "running", "complete", "superseded"]},
    "hosts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profile_id", "host", "kind", "predecessor", "status", "result_refs", "restored_state_ref", "disposition_notes"],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "host": {"enum": ["rtxpro6000-win-a", "rtx5090-win-a", "rtx3090-win-a", "mac-studio-client"]},
          "kind": {"enum": ["server", "client-route"]},
          "predecessor": {
            "type": "object", "additionalProperties": false,
            "required": ["profile_id", "strata_tag", "omp_tag", "manifest"],
            "properties": {
              "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
              "strata_tag": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
              "omp_tag": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
              "manifest": {"type": "string", "pattern": "^releases/[a-z0-9._-]+/manifest\\.json$"}
            }
          },
          "status": {"enum": ["pending", "queued", "running", "qualified", "failed", "blocked"]},
          "result_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "restored_state_ref": {"type": ["string", "null"], "minLength": 1},
          "superseded_by": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
          "disposition_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "disposition_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
