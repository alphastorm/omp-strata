+"""Read the documented settlement CSV format."""
+import csv
+from datetime import datetime
+from decimal import Decimal
+
+
+def read_events(path):
+    with path.open(encoding="utf-8", newline="") as stream:
+        for row in csv.DictReader(stream):
+            numerator, denominator = Decimal(row["amount"]).as_integer_ratio()
+            yield {
+                "account": row["account"], "event": row["event"],
+                "at": datetime.fromisoformat(row["at"]), "kind": row["kind"],
+                "cents": numerator * 100 // denominator, "reference": row["reference"],
+            }
diff --git a/ledger/reduce.py b/ledger/reduce.py
--- a/ledger/reduce.py
+++ b/ledger/reduce.py
@@ -1,10 +1,11 @@
-"""Reduce one batch, ignoring retransmissions and explicit voids."""
-
-
-def settle(events):
-    unique = {}
-    for event in events:
-        unique.setdefault(event["event"], event)
-    voided = {event["reference"] for event in unique.values() if event["kind"] == "void"}
-    return [event for event in unique.values()
-            if event["kind"] == "charge" and event["event"] not in voided]
+"""Reduce one batch, ignoring retransmissions and explicit voids."""
+
+
+def settle(events):
+    unique = {}
+    for event in events:
+        unique.setdefault((event["account"], event["event"]), event)
+    voided = {(event["account"], event["reference"]) for event in unique.values()
+              if event["kind"] == "void"}
+    return [event for event in unique.values() if event["kind"] == "charge"
+            and (event["account"], event["event"]) not in voided]
