+"""Aggregate the selected settlement window."""
+from .reader import read_events
+from .reduce import settle
+
+
+def report(path, start, end):
+    totals = {}
+    for event in settle(read_events(path)):
+        if start <= event["at"] < end:
+            totals[event["account"]] = totals.get(event["account"], 0) + event["cents"]
+    return dict(sorted(totals.items()))
